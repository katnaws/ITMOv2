+++ b/practices/practice_04/hooks/post-commit
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR=$(git rev-parse --show-toplevel)
+cd "$ROOT_DIR"
+
+if git diff-tree --no-commit-id --name-only -r HEAD | grep -Eq '^practices/practice_04/'; then
+  echo "[post-commit] practice_04 changes detected, running runner..."
+  bash practices/practice_04/runner.sh || true
+else
+  echo "[post-commit] no practice_04 changes"
+fi
