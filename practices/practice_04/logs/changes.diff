+{
+  "changeName": "deadline-change",
+  "artifactId": "proposal",
+  "schemaName": "spec-driven",
+  "changeDir": "/private/tmp/practice05-framework-replay-20261102/openspec/changes/deadline-change",
+  "planningHome": {
+    "kind": "repo",
+    "root": "/private/tmp/practice05-framework-replay-20261102",
+    "changesDir": "/private/tmp/practice05-framework-replay-20261102/openspec/changes",
